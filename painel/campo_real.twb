      <aliases enabled='yes' />
      <column caption='Geração MWh' datatype='real' name='[Calculation_1833776979263500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([energia_mwh])' />
      </column>
      <column caption='Receita PLD (R$)' datatype='real' name='[Calculation_1833776979300365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([receita_pld_rs])' />
      </column>
      <column caption='Geração valorada MWh' datatype='real' name='[Calculation_1833776979345422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([receita_pld_rs]) THEN [energia_mwh] END)' />
      </column>
      <column caption='Preço capturado (R$/MWh)' datatype='real' name='[Calculation_1833776979394575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1833776979300365] / [Calculation_1833776979345422]' />
      </column>
      <column caption='PLD médio (R$/MWh)' datatype='real' name='[Calculation_1833776979472400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pld_rs_mwh])' />
      </column>
      <column caption='Razão de captura' datatype='real' name='[Calculation_1833776979542033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1833776979394575] / [Calculation_1833776979472400]' />
      </column>
      <column caption='Fator de capacidade' datatype='real' name='[Calculation_1833776979582994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([energia_mwh]) / (AVG([potencia_mw]) * COUNTD([sk_tempo]))' />
      </column>
      <column caption='Horas indisponíveis' datatype='real' name='[Calculation_1833776979623955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([horas_indisponiveis])' />
      </column>
      <column caption='Energia não gerada (MWh)' datatype='real' name='[Calculation_1833776979697684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([energia_nao_gerada_mwh])' />
      </column>
      <column caption='Receita não gerada (R$)' datatype='real' name='[Calculation_1833776979730453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([receita_nao_gerada_rs])' />
      </column>
      <column caption='Radiação média (W/m²)AVG([radiacao_wm2])' datatype='real' name='[Calculation_1833776979767318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([radiacao_wm2])' />
      </column>
      <column caption='Vento médio 100 m (km/h)' datatype='real' name='[Calculation_1833776979816471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([vento_100m_kmh])' />
      </column>
      <column caption='Índice da dimensão' datatype='real' name='[Calculation_1833776979857432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [registros_avaliados] &gt; 0 THEN [indice_qualidade] END)' />
      </column>
      <column caption='Índice geral' datatype='real' name='[Calculation_1833776979898393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_1833776979857432])   // Calcular usando: dimensao (dimensao no Detalhe)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Falhas antes' datatype='integer' name='[Calculation_1833776979935258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fase] = &quot;ANTES&quot;  THEN [registros_falha] END)' />
      </column>
      <column caption='Falhas depois' datatype='integer' name='[Calculation_1833776979988507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fase] = &quot;DEPOIS&quot; THEN [registros_falha] END)' />
      </column>
      <column caption='Receita antes (R$)' datatype='real' name='[Calculation_1833776980029468]' role='measure' type='quantitative'>
